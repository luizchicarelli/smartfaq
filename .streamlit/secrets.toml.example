# Copie este arquivo para .streamlit/secrets.toml e preencha com sua
# própria chave. NUNCA faça commit do secrets.toml de verdade (ele já
# está no .gitignore).
#
# Como gerar a chave: https://aistudio.google.com/apikey
# (camada gratuita é suficiente para uso do protótipo; não precisa
# configurar faturamento)
#
# IMPORTANTE: o valor precisa ficar entre aspas, senão o Streamlit não
# consegue ler o arquivo (TOML exige aspas em strings).

GEMINI_API_KEY = "sua-chave-aqui"

# Conexão com o Supabase: painel do projeto > Connect > Session pooler > URI
DATABASE_URL = "postgresql://postgres.xxxx:SUA_SENHA@aws-...pooler.supabase.com:5432/postgres"

# Opcional: modelo do Gemini (padrão: gemini-3.8-flash). Troque aqui se
# o modelo for descontinuado, sem mexer no código.
# GEMINI_MODEL = "gemini-3.8-flash"
# GEMINI_MODELS_RESERVA = "gemini-3.5-flash,gemini-flash-lite-latest"
